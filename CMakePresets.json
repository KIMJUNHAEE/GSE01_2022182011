{
    "version": 5,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "windows-ninja",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/cmake/${presetName}",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug (MSVC / Ninja)",
            "inherits": "windows-ninja",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIMPLEGAME_ARCHITECTURE": "x64" }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release (MSVC / Ninja)",
            "inherits": "windows-ninja",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIMPLEGAME_ARCHITECTURE": "x64" }
        },
        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 Debug (MSVC / Ninja)",
            "inherits": "windows-ninja",
            "architecture": { "value": "x86", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIMPLEGAME_ARCHITECTURE": "Win32" }
        },
        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 Release (MSVC / Ninja)",
            "inherits": "windows-ninja",
            "architecture": { "value": "x86", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIMPLEGAME_ARCHITECTURE": "Win32" }
        }
    ],
    "buildPresets": [
        { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" },
        { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
        { "name": "windows-x86-debug", "configurePreset": "windows-x86-debug" },
        { "name": "windows-x86-release", "configurePreset": "windows-x86-release" }
    ]
}
