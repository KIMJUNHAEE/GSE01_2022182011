  <Target Name="ValidateGlewRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GlewArchitecture)'==''" Text="Only Win32 and x64 GLEW runtimes are packaged." />
    <Error Condition="!Exists('$(GlewRuntime)')" Text="Missing packaged GLEW runtime: $(GlewRuntime)" />
    <!-- Each hash pins a PE machine checked in GLEW/runtime-manifest.json. -->
    <GetFileHash Files="$(GlewRuntime)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ActualGlewRuntimeSHA256" />
    </GetFileHash>
    <Error Condition="'$(ActualGlewRuntimeSHA256)'!='$(GlewRuntimeSHA256)'" Text="GLEW runtime hash/architecture mismatch. See Dependencies\GLEW\runtime-manifest.json." />
  </Target>
  <Target Name="CopyGameResources" AfterTargets="Build" DependsOnTargets="ValidateGlewRuntime">
    <ItemGroup>
      <RuntimeShaders Include="$(ProjectDir)Shaders\**\*" />
      <RuntimeResources Include="$(ProjectDir)Resources\**\*" Exclude="$(ProjectDir)Resources\**\*.blend*;$(ProjectDir)Resources\**\Previews\**\*;$(ProjectDir)Resources\**\*Preview*\**\*;$(ProjectDir)Resources\**\*Preview*" />
      <RuntimeModelNotices Include="$(ProjectDir)Dependencies\cgltf.LICENSE;$(ProjectDir)Dependencies\json.LICENSE;$(ProjectDir)Dependencies\ModelLoader_NOTICES.md" />
      <RuntimeDependencyNotices Include="$(ProjectDir)Dependencies\GLEW\LICENSE.txt;$(ProjectDir)Dependencies\GLEW\runtime-manifest.json;$(ProjectDir)Dependencies\GLEW\README.md;$(ProjectDir)Dependencies\GLFW\LICENSE.md;$(ProjectDir)Dependencies\GLFW.UPSTREAM.json;$(ProjectDir)Dependencies\stb_image.h" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeShaders)" DestinationFiles="@(RuntimeShaders->'$(TargetDir)Shaders\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeResources)" DestinationFiles="@(RuntimeResources->'$(TargetDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeModelNotices)" DestinationFolder="$(TargetDir)Licenses" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeDependencyNotices)" DestinationFolder="$(TargetDir)Licenses" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(GlewRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
